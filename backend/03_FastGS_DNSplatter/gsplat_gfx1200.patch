diff --git a/gsplat/cuda/csrc/RasterizeCheckpointGfx1200.cu b/gsplat/cuda/csrc/RasterizeCheckpointGfx1200.cu
new file mode 100644
index 0000000..5940325
--- /dev/null
+++ b/gsplat/cuda/csrc/RasterizeCheckpointGfx1200.cu
@@ -0,0 +1,366 @@
+// Independent gfx1200 checkpoint rasterization for GlomeHomeTour.
+// SPDX-License-Identifier: Apache-2.0
+#if USE_ROCM
+#include <ATen/ATen.h>
+#include <c10/core/DeviceGuard.h>
+#include <c10/hip/HIPStream.h>
+#include <c10/hip/HIPException.h>
+#include <hip/hip_runtime.h>
+#include <tuple>
+#include <limits>
+#include "Ops.h"
+namespace gsplat {
+static_assert(sizeof(float2)==8 && sizeof(float3)==12 && sizeof(float4)==16);
+
+// Determine the furthest accepted Gaussian in each tile after a cheap prepass.
+__global__ void checkpoint_tile_bounds(const int* last,int width,int height,int tw,int th,int* bounds) {
+ int t=threadIdx.x,tile=blockIdx.x,image=tile/(tw*th),tid=tile%(tw*th);
+ int y=tid/tw*16+t/16,x=tid%tw*16+t%16;
+ int value=(y<height && x<width) ? last[image*width*height+y*width+x] : 0;
+ for(int d=16;d;d/=2) value=max(value,__shfl_xor(value,d,32));
+ __shared__ int waves[8];
+ if(t%32==0) waves[t/32]=value;
+ __syncthreads();
+ if(t==0) {value=0;for(int w=0;w<8;++w) value=max(value,waves[w]);bounds[tile]=value;}
+}
+
+template<int TILE>
+__global__ void checkpoint_forward(const float2* means,const float3* conics,const float4* colors,const float* opacity,
+ const float4* bg,const bool* mask,int width,int height,int ignored_tile,int tw,int th,int total,int nids,
+ const int* offsets,const int* ids,const int* bucket_offsets,float* checkpoints,
+ float4* output,float* alpha,int* last,int* bounds,const int* reached) {
+ int t=threadIdx.x,area=TILE*TILE,global_tile=blockIdx.x,image=global_tile/(tw*th),tid=global_tile%(tw*th);
+ int row=tid/tw*TILE+t/TILE,col=tid%tw*TILE+t%TILE;
+ bool inside=row<height && col<width,done=!inside || (mask && !mask[global_tile]);
+ int pixel=image*width*height+row*width+col;
+ int begin=offsets[global_tile],end=global_tile+1<total ? offsets[global_tile+1] : nids;
+ if(reached) end=min(end,reached[global_tile]+1);
+ __shared__ float4 positions[TILE*TILE],features[TILE*TILE];
+ __shared__ float3 shapes[TILE*TILE];
+ __shared__ int wave_bounds[32];
+ float T=1;float4 prefix=make_float4(0,0,0,0);int cur=0;
+ for(int b=begin;b<end;b+=area) {
+  if(__syncthreads_count(done)==area) break;
+  int index=b+t;
+  if(index<end) {int g=ids[index];float2 m=means[g];positions[t]=make_float4(m.x,m.y,opacity[g],0);shapes[t]=conics[g];features[t]=colors[g];}
+  __syncthreads();
+  int count=min(area,end-b);
+  for(int j=0;j<count;++j) {
+   int index=b+j;
+   if((index-begin)%32==0) {
+    int checkpoint=bucket_offsets[global_tile]+(index-begin)/32;
+    float* dst=checkpoints+(int64_t(checkpoint)*area+t)*5;
+    dst[0]=done ? 0 : T;dst[1]=prefix.x;dst[2]=prefix.y;dst[3]=prefix.z;dst[4]=prefix.w;
+   }
+   if(done) continue;
+   float4 pos=positions[j];float3 q=shapes[j];
+   float dx=pos.x-(col+.5f),dy=pos.y-(row+.5f);
+   float sigma=.5f*(q.x*dx*dx+q.z*dy*dy)+q.y*dx*dy;
+   float a=fminf(.999f,pos.z*__expf(-sigma));
+   if(sigma<0 || a<1.f/255.f) continue;
+   float next=T*(1-a);
+   if(next<=1e-4f) {done=true;continue;}
+   float weight=a*T;float4 c=features[j];
+   prefix.x+=c.x*weight;prefix.y+=c.y*weight;prefix.z+=c.z*weight;prefix.w+=c.w*weight;
+   T=next;cur=index;
+  }
+  __syncthreads();
+ }
+ if(inside) {
+  alpha[pixel]=mask && !mask[global_tile] ? 0 : 1-T;last[pixel]=cur;
+  float4 c=bg ? bg[image] : make_float4(0,0,0,0);
+  output[pixel]=make_float4(prefix.x+T*c.x,prefix.y+T*c.y,prefix.z+T*c.z,prefix.w+T*c.w);
+ }
+ int bound=inside ? cur : 0;
+ for(int delta=16;delta;delta/=2) bound=max(bound,__shfl_xor(bound,delta,32));
+ if(t%32==0) wave_bounds[t/32]=bound;
+ __syncthreads();
+ if(t==0) {bound=0;for(int w=0;w<(area+31)/32;++w) bound=max(bound,wave_bounds[w]);bounds[global_tile]=bound;}
+}
+
+template<int TILE>
+__global__ void bucket_backward(const float2* means,const float3* conics,const float4* colors,const float* opacity,
+ const bool* mask,int width,int height,int ignored_tile,int tw,int th,int buckets,int nids,
+ const int* offsets,const int* ids,const int* bucket_offsets,const int* bucket_tiles,
+ const float* checkpoints,const int* bounds,const float4* rendered,const float* alphas,const int* last,
+ const float4* vc,const float* va,float2* vm,float3* vq,float4* vcol,float* vo,float2* ab) {
+ int lane=threadIdx.x%32,bucket=blockIdx.x*4+threadIdx.x/32;
+ if(bucket>=buckets) return;
+ int global_tile=bucket_tiles[bucket];
+ if(mask && !mask[global_tile]) return;
+ int begin=offsets[global_tile]+32*(bucket-bucket_offsets[global_tile]);
+ if(begin>bounds[global_tile]) return;
+ int tiles=tw*th,image=global_tile/tiles,tid=global_tile%tiles;
+ int end=offsets[global_tile+1]; // Sentinel nids follows the flattened offsets.
+ int index=begin+lane;bool gaussian_valid=index<end;
+ int g=gaussian_valid ? ids[index] : 0;
+ float2 m=gaussian_valid ? means[g] : make_float2(0,0);
+ float3 q=gaussian_valid ? conics[g] : make_float3(0,0,0);
+ float4 c=gaussian_valid ? colors[g] : make_float4(0,0,0,0);
+ float op=gaussian_valid ? opacity[g] : 0;
+ float2 gm=make_float2(0,0),ga=make_float2(0,0);float3 gq=make_float3(0,0,0);
+ float4 gc=make_float4(0,0,0,0);float go=0;
+ float T=0;float4 prefix=make_float4(0,0,0,0);int area=TILE*TILE;
+ for(int k=0;k<area+31;++k) {
+  int p=k-lane;
+  int row=tid/tw*TILE+p/TILE,col=tid%tw*TILE+p%TILE;
+  bool inside=p>=0 && p<area && row<height && col<width;
+  if(lane==0 && k<area) {
+   const float* cp=checkpoints+(int64_t(bucket)*area+k)*5;
+   T=cp[0];prefix=make_float4(cp[1],cp[2],cp[3],cp[4]);
+  }
+  if(inside && gaussian_valid && T>0) {
+   int pixel=image*width*height+row*width+col;
+   if(index<=last[pixel]) {
+    float dx=m.x-(col+.5f),dy=m.y-(row+.5f);
+    float sigma=.5f*(q.x*dx*dx+q.z*dy*dy)+q.y*dx*dy;
+    float vis=__expf(-sigma),a=fminf(.999f,op*vis);
+    if(sigma>=0 && a>=1.f/255.f) {
+     float weight=a*T;float4 grad=vc[pixel],final=rendered[pixel];float ra=1.f/(1-a);
+     float4 after=make_float4(prefix.x+weight*c.x,prefix.y+weight*c.y,prefix.z+weight*c.z,prefix.w+weight*c.w);
+     float dalpha=(T*c.x-(final.x-after.x)*ra)*grad.x;
+     dalpha+=(T*c.y-(final.y-after.y)*ra)*grad.y;
+     dalpha+=(T*c.z-(final.z-after.z)*ra)*grad.z;
+     dalpha+=(T*c.w-(final.w-after.w)*ra)*grad.w;
+     dalpha+=(1-alphas[pixel])*ra*va[pixel];
+     gc.x+=weight*grad.x;gc.y+=weight*grad.y;gc.z+=weight*grad.z;gc.w+=weight*grad.w;
+     if(op*vis<=.999f) {
+      float ds=-op*vis*dalpha;
+      gq.x+=.5f*ds*dx*dx;gq.y+=ds*dx*dy;gq.z+=.5f*ds*dy*dy;
+      float mx=ds*(q.x*dx+q.y*dy),my=ds*(q.y*dx+q.z*dy);
+      gm.x+=mx;gm.y+=my;ga.x+=fabsf(mx);ga.y+=fabsf(my);go+=vis*dalpha;
+     }
+     T*=1-a;prefix=after;
+    }
+   }
+  }
+  T=__shfl_up(T,1,32);
+  prefix.x=__shfl_up(prefix.x,1,32);prefix.y=__shfl_up(prefix.y,1,32);
+  prefix.z=__shfl_up(prefix.z,1,32);prefix.w=__shfl_up(prefix.w,1,32);
+ }
+ if(gaussian_valid) {
+  atomicAdd(&vm[g].x,gm.x);atomicAdd(&vm[g].y,gm.y);
+  atomicAdd(&vq[g].x,gq.x);atomicAdd(&vq[g].y,gq.y);atomicAdd(&vq[g].z,gq.z);
+  atomicAdd(&vcol[g].x,gc.x);atomicAdd(&vcol[g].y,gc.y);atomicAdd(&vcol[g].z,gc.z);atomicAdd(&vcol[g].w,gc.w);
+  atomicAdd(vo+g,go);if(ab) {atomicAdd(&ab[g].x,ga.x);atomicAdd(&ab[g].y,ga.y);}
+ }
+}
+
+using Forward=std::tuple<at::Tensor,at::Tensor,at::Tensor,at::Tensor,at::Tensor>;
+template<int TILE>
+Forward checkpoint_forward_impl(at::Tensor means,at::Tensor conics,at::Tensor colors,at::Tensor opacity,
+ std::optional<at::Tensor> bg,std::optional<at::Tensor> mask,int64_t width,int64_t height,int64_t tile,
+ at::Tensor offsets,at::Tensor ids,at::Tensor bucket_offsets,int64_t buckets,std::optional<at::Tensor> reached=std::nullopt) {
+ c10::DeviceGuard guard(means.device());
+ int tw=offsets.size(-1),th=offsets.size(-2),images=offsets.numel()/(tw*th);
+ auto out=at::empty({images,height,width,4},means.options()),alpha=at::empty({images,height,width,1},means.options());
+ auto last=at::empty({images,height,width},offsets.options()),bounds=at::empty({offsets.numel()},offsets.options());
+ auto cp=at::empty({buckets,tile*tile,5},means.options());
+ checkpoint_forward<TILE><<<offsets.numel(),tile*tile,0,c10::hip::getCurrentHIPStream()>>>(
+  (float2*)means.data_ptr<float>(),(float3*)conics.data_ptr<float>(),(float4*)colors.data_ptr<float>(),opacity.data_ptr<float>(),
+  bg ? (float4*)bg->data_ptr<float>() : nullptr,mask ? mask->data_ptr<bool>() : nullptr,
+  width,height,tile,tw,th,offsets.numel(),ids.numel(),offsets.data_ptr<int>(),ids.data_ptr<int>(),bucket_offsets.data_ptr<int>(),
+  cp.data_ptr<float>(),(float4*)out.data_ptr<float>(),alpha.data_ptr<float>(),last.data_ptr<int>(),bounds.data_ptr<int>(),reached ? reached->data_ptr<int>() : nullptr);
+ C10_HIP_CHECK(hipGetLastError());return {out,alpha,last,cp,bounds};
+}
+using Result=std::tuple<std::optional<at::Tensor>,at::Tensor,at::Tensor,at::Tensor,at::Tensor>;
+template<int TILE>
+Result checkpoint_backward_impl(at::Tensor means,at::Tensor conics,at::Tensor colors,at::Tensor opacity,std::optional<at::Tensor> mask,
+ int64_t width,int64_t height,int64_t tile,at::Tensor offsets,at::Tensor ids,at::Tensor bucket_offsets,at::Tensor bucket_tiles,
+ at::Tensor rendered,at::Tensor alpha,at::Tensor last,at::Tensor cp,at::Tensor bounds,at::Tensor vc,at::Tensor va,bool absolute) {
+ c10::DeviceGuard guard(means.device());
+ auto vm=at::zeros_like(means),vq=at::zeros_like(conics),vcol=at::zeros_like(colors),vo=at::zeros_like(opacity);
+ std::optional<at::Tensor> ab=absolute ? std::optional<at::Tensor>(at::zeros_like(means)) : std::nullopt;
+ int buckets=bucket_tiles.numel(),tw=(width+tile-1)/tile,th=(height+tile-1)/tile;
+ if(buckets) bucket_backward<TILE><<<(buckets+3)/4,128,0,c10::hip::getCurrentHIPStream()>>>(
+  (float2*)means.data_ptr<float>(),(float3*)conics.data_ptr<float>(),(float4*)colors.data_ptr<float>(),opacity.data_ptr<float>(),
+  mask ? mask->data_ptr<bool>() : nullptr,width,height,tile,tw,th,buckets,ids.numel(),offsets.data_ptr<int>(),ids.data_ptr<int>(),
+  bucket_offsets.data_ptr<int>(),bucket_tiles.data_ptr<int>(),cp.data_ptr<float>(),bounds.data_ptr<int>(),(float4*)rendered.data_ptr<float>(),
+  alpha.data_ptr<float>(),last.data_ptr<int>(),(float4*)vc.data_ptr<float>(),va.data_ptr<float>(),
+  (float2*)vm.data_ptr<float>(),(float3*)vq.data_ptr<float>(),(float4*)vcol.data_ptr<float>(),vo.data_ptr<float>(),ab ? (float2*)ab->data_ptr<float>() : nullptr);
+ C10_HIP_CHECK(hipGetLastError());return {ab,vm,vq,vcol,vo};
+}
+
+static void check_checkpoint_inputs(at::Tensor means,at::Tensor conics,at::Tensor colors,at::Tensor opacity,
+ std::optional<at::Tensor> bg,std::optional<at::Tensor> mask,int64_t width,int64_t height,int64_t tile) {
+ TORCH_CHECK(width>0 && height>0 && tile==16,"checkpoint rasterization requires tile16 and positive dimensions");
+ TORCH_CHECK((means.dim()==2 || means.dim()==3) && means.size(-1)==2,"unsupported means shape");
+ for(const auto& t:{means,conics,colors,opacity}) {
+  TORCH_CHECK(t.device()==means.device() && t.is_cuda() && t.is_contiguous() && t.scalar_type()==at::kFloat,"expected contiguous float32 tensors on one GPU");
+ }
+ TORCH_CHECK(conics.size(-1)==3 && colors.size(-1)==4 && conics.numel()/3==means.numel()/2 && colors.numel()/4==means.numel()/2 && opacity.numel()==means.numel()/2,"inconsistent Gaussian shapes");
+ if(bg) TORCH_CHECK(bg->device()==means.device() && bg->is_contiguous() && bg->scalar_type()==at::kFloat && bg->size(-1)==4,"invalid background");
+ if(mask) TORCH_CHECK(mask->device()==means.device() && mask->is_contiguous() && mask->scalar_type()==at::kBool,"invalid tile mask");
+}
+
+CheckpointForward rasterize_checkpoint_3dgs_fwd(at::Tensor means,at::Tensor conics,at::Tensor colors,at::Tensor opacity,
+ std::optional<at::Tensor> bg,std::optional<at::Tensor> mask,int64_t width,int64_t height,int64_t tile,
+ at::Tensor offsets,at::Tensor ids) {
+ check_checkpoint_inputs(means,conics,colors,opacity,bg,mask,width,height,tile);
+ c10::DeviceGuard guard(means.device());
+ TORCH_CHECK(offsets.dim()==3 && offsets.is_contiguous() && offsets.scalar_type()==at::kInt && offsets.device()==means.device(),"invalid offsets");
+ TORCH_CHECK(ids.dim()==1 && ids.is_contiguous() && ids.scalar_type()==at::kInt && ids.device()==means.device(),"invalid IDs");
+ int64_t images=offsets.size(0),tw=(width+15)/16,th=(height+15)/16;
+ TORCH_CHECK(offsets.size(1)==th && offsets.size(2)==tw && images*width*height<INT32_MAX && ids.numel()<INT32_MAX,"unsupported image/intersection size");
+ if(bg) TORCH_CHECK(bg->numel()==images*4,"background size mismatch");
+ if(mask) TORCH_CHECK(mask->sizes()==offsets.sizes(),"mask size mismatch");
+ auto sentinel=at::cat({offsets.flatten(),at::full({1},ids.numel(),offsets.options())});
+ auto lengths=sentinel.slice(0,1)-sentinel.slice(0,0,-1);
+ auto counts=at::floor_divide(lengths+31,32);
+ auto bucket_offsets=at::cat({at::zeros({1},offsets.options()),at::cumsum(counts,0,at::kInt)});
+ int64_t buckets=bucket_offsets[-1].item<int32_t>();
+ TORCH_CHECK(buckets>=0,"negative bucket count");
+ int64_t bytes=buckets*int64_t(256*5*sizeof(float));
+ size_t free_bytes,total_bytes;
+ C10_HIP_CHECK(hipMemGetInfo(&free_bytes,&total_bytes));
+ int64_t memory_limit=std::min<int64_t>(1024*1024*1024LL,int64_t(free_bytes/3));
+ std::optional<at::Tensor> reached;
+ if(bytes>memory_limit) {
+  auto [r,a,last]=rasterize_to_pixels_3dgs_fwd(means,conics,colors,opacity,bg,mask,width,height,tile,offsets,ids);
+  reached=at::empty({offsets.numel()},offsets.options());
+  checkpoint_tile_bounds<<<offsets.numel(),256,0,c10::hip::getCurrentHIPStream()>>>(
+      last.data_ptr<int>(),width,height,tw,th,reached->data_ptr<int>());
+  C10_HIP_CHECK(hipGetLastError());
+  auto visible_lengths=at::minimum(lengths,at::clamp_min(*reached-offsets.flatten()+1,0));
+  counts=at::floor_divide(visible_lengths+31,32);
+  bucket_offsets=at::cat({at::zeros({1},offsets.options()),at::cumsum(counts,0,at::kInt)});
+  buckets=bucket_offsets[-1].item<int32_t>();
+  TORCH_CHECK(buckets>=0,"negative visible bucket count");
+  bytes=buckets*int64_t(256*5*sizeof(float));
+  if(bytes>memory_limit) {
+   auto empty=at::empty({0},means.options());
+   return {r,a,last,empty,empty,empty,empty,empty};
+  }
+ }
+ auto bucket_tiles=at::repeat_interleave(counts,std::optional<int64_t>(buckets));
+ auto [r,a,last,cp,bounds]=checkpoint_forward_impl<16>(means,conics,colors,opacity,bg,mask,width,height,tile,offsets,ids,bucket_offsets,buckets,reached);
+
+ return {r,a,last,cp,bounds,bucket_offsets,bucket_tiles,sentinel};
+}
+CheckpointBackward rasterize_checkpoint_3dgs_bwd(at::Tensor means,at::Tensor conics,at::Tensor colors,at::Tensor opacity,std::optional<at::Tensor> mask,
+ int64_t width,int64_t height,int64_t tile,at::Tensor offsets,at::Tensor ids,at::Tensor bucket_offsets,at::Tensor bucket_tiles,
+ at::Tensor rendered,at::Tensor alpha,at::Tensor last,at::Tensor cp,at::Tensor bounds,at::Tensor vc,at::Tensor va,bool absolute) {
+ check_checkpoint_inputs(means,conics,colors,opacity,std::nullopt,mask,width,height,tile);
+ for(const auto& t:{offsets,ids,bucket_offsets,bucket_tiles,last,bounds})
+  TORCH_CHECK(t.device()==means.device() && t.is_contiguous() && t.scalar_type()==at::kInt,"invalid checkpoint indices");
+ for(const auto& t:{rendered,alpha,cp,vc,va})
+  TORCH_CHECK(t.device()==means.device() && t.is_contiguous() && t.scalar_type()==at::kFloat,"invalid checkpoint image tensors");
+ TORCH_CHECK(rendered.sizes()==vc.sizes() && alpha.sizes()==va.sizes() && rendered.size(-1)==4 && alpha.size(-1)==1,"invalid render gradient shapes");
+ TORCH_CHECK(rendered.numel()==alpha.numel()*4 && last.numel()==alpha.numel(),"invalid render sizes");
+ TORCH_CHECK(cp.numel()==bucket_tiles.numel()*int64_t(256*5) && offsets.numel()==bounds.numel()+1 && bucket_offsets.numel()==offsets.numel(),"invalid checkpoint metadata sizes");
+ return checkpoint_backward_impl<16>(means,conics,colors,opacity,mask,width,height,tile,offsets,ids,bucket_offsets,bucket_tiles,rendered,alpha,last,cp,bounds,vc,va,absolute);
+}
+namespace {
+constexpr int kTile = 16;
+constexpr int kThreads = 256;
+
+__global__ void vcp_counts_kernel(
+    const float* __restrict__ means, const float* __restrict__ conics,
+    const float* __restrict__ opacities, const bool* __restrict__ metric_map,
+    const int32_t* __restrict__ offsets, const int32_t* __restrict__ flat_ids,
+    int32_t* __restrict__ counts, int width, int height, int tile_width,
+    int tile_height, int n, int n_isects) {
+  const int tx = threadIdx.x, ty = threadIdx.y;
+  const int linear = ty * kTile + tx;
+  const int tile_x = blockIdx.x, tile_y = blockIdx.y;
+  const int tile = tile_y * tile_width + tile_x;
+  const int pixel_x = tile_x * kTile + tx, pixel_y = tile_y * kTile + ty;
+  bool done = pixel_x >= width || pixel_y >= height;
+  float transmittance = 1.f;
+
+  int start = offsets[tile];
+  int end = tile + 1 == tile_width * tile_height ? n_isects : offsets[tile + 1];
+  start = max(0, min(start, n_isects));
+  end = max(start, min(end, n_isects));
+  __shared__ int32_t ids[kThreads];
+  __shared__ float geometry[kThreads][6]; // mean xy, conic abc, opacity
+
+  for (int batch = start; batch < end; batch += kThreads) {
+    if (__syncthreads_count(done) == kThreads) break;
+    const int at = batch + linear;
+    if (at < end) {
+      const int g = flat_ids[at];
+      ids[linear] = g;
+      if (g >= 0 && g < n) {
+        const float* mean = means + 2 * g;
+        const float* conic = conics + 3 * g;
+        geometry[linear][0] = mean[0]; geometry[linear][1] = mean[1];
+        geometry[linear][2] = conic[0]; geometry[linear][3] = conic[1];
+        geometry[linear][4] = conic[2]; geometry[linear][5] = opacities[g];
+      }
+    }
+    __syncthreads();
+    const int batch_size = min(kThreads, end - batch);
+    for (int t = 0; t < batch_size; ++t) {
+      const int g = ids[t];
+      bool contributing = false;
+      if (!done && g >= 0 && g < n) {
+        const float dx = geometry[t][0] - (pixel_x + .5f);
+        const float dy = geometry[t][1] - (pixel_y + .5f);
+        const float sigma = .5f * (geometry[t][2] * dx * dx + geometry[t][4] * dy * dy)
+                          + geometry[t][3] * dx * dy;
+        const float alpha = min(.999f, geometry[t][5] * __expf(-sigma));
+        if (sigma >= 0.f && alpha >= 1.f / 255.f) {
+          const float next_t = transmittance * (1.f - alpha);
+          if (next_t <= 1e-4f) done = true; // terminal Gaussian is excluded.
+          else {
+            contributing = metric_map[pixel_y * width + pixel_x];
+            transmittance = next_t;
+          }
+        }
+      }
+      // All lanes, including finished pixels, participate in the ballot.
+      const unsigned long long votes = __ballot(contributing);
+      if (linear % warpSize == 0 && votes) atomicAdd(counts + g, __popcll(votes));
+    }
+    __syncthreads();
+  }
+}
+} // namespace
+
+at::Tensor rasterize_vcp_counts(at::Tensor means, at::Tensor conics, at::Tensor opacities,
+                         at::Tensor metric_map, at::Tensor tile_offsets,
+                         at::Tensor flat_ids) {
+  TORCH_CHECK(means.is_cuda() && conics.is_cuda() && opacities.is_cuda() && metric_map.is_cuda()
+              && tile_offsets.is_cuda() && flat_ids.is_cuda(), "all inputs must be device tensors");
+  TORCH_CHECK(means.device() == conics.device() && means.device() == opacities.device()
+              && means.device() == metric_map.device() && means.device() == tile_offsets.device()
+              && means.device() == flat_ids.device(), "all inputs must share a device");
+  TORCH_CHECK(means.is_contiguous() && conics.is_contiguous() && opacities.is_contiguous()
+              && metric_map.is_contiguous() && tile_offsets.is_contiguous() && flat_ids.is_contiguous(),
+              "all inputs must be contiguous");
+  TORCH_CHECK(means.scalar_type() == at::kFloat && conics.scalar_type() == at::kFloat
+              && opacities.scalar_type() == at::kFloat, "geometry must be float32");
+  TORCH_CHECK(metric_map.scalar_type() == at::kBool && tile_offsets.scalar_type() == at::kInt
+              && flat_ids.scalar_type() == at::kInt, "metricMap must be bool; offsets and IDs int32");
+  TORCH_CHECK(means.dim() == 3 && means.size(0) == 1 && means.size(2) == 2,
+              "means must be contiguous [1,N,2]");
+  TORCH_CHECK(conics.dim() == 3 && conics.size(0) == 1 && conics.size(1) == means.size(1)
+              && conics.size(2) == 3, "conics must be [1,N,3]");
+  TORCH_CHECK(opacities.dim() == 2 && opacities.size(0) == 1 && opacities.size(1) == means.size(1),
+              "opacities must be [1,N]");
+  TORCH_CHECK(metric_map.dim() == 3 && metric_map.size(0) == 1, "metricMap must be [1,H,W]");
+  TORCH_CHECK(tile_offsets.dim() == 3 && tile_offsets.size(0) == 1, "tileOffsets must be [1,th,tw]");
+  TORCH_CHECK(tile_offsets.size(1) == (metric_map.size(1) + 15) / 16
+              && tile_offsets.size(2) == (metric_map.size(2) + 15) / 16,
+              "tileOffsets must use 16-pixel tiles");
+  TORCH_CHECK(flat_ids.dim() == 1, "flatIDs must be flat");
+  const auto limit = std::numeric_limits<int>::max();
+  TORCH_CHECK(means.size(1) <= limit && metric_map.size(1) <= limit && metric_map.size(2) <= limit
+              && flat_ids.numel() <= limit && metric_map.size(1) * metric_map.size(2) <= limit,
+              "N, image dimensions, pixel count, and flatIDs length must fit int32");
+  TORCH_CHECK(metric_map.size(1)>0 && metric_map.size(2)>0, "positive image dimensions required");
+  c10::DeviceGuard guard(means.device());
+  auto out = at::zeros({means.size(1)}, means.options().dtype(at::kInt));
+  int width=metric_map.size(2), height=metric_map.size(1);
+  dim3 block(16,16), grid((width+15)/16,(height+15)/16);
+  vcp_counts_kernel<<<grid,block,0,c10::hip::getCurrentHIPStream()>>>(
+      means.data_ptr<float>(), conics.data_ptr<float>(), opacities.data_ptr<float>(),
+      metric_map.data_ptr<bool>(), tile_offsets.data_ptr<int32_t>(), flat_ids.data_ptr<int32_t>(),
+      out.data_ptr<int32_t>(), width,height,tile_offsets.size(2),tile_offsets.size(1),means.size(1),flat_ids.numel());
+  C10_HIP_CHECK(hipGetLastError());
+  return out;
+}
