@@ -1,9 +1,32 @@
 #include "cumesh.h"
+#include <algorithm>
 
 
 namespace cumesh {
 
 
+// ponytail: hipMemcpy2D silently copies only the first 2^20 rows and still returns
+// success, so any mesh past ~1M verts/faces loses its tail. Chunk the height.
+static cudaError_t cudaMemcpy2D_chunked(
+    void* dst, size_t dpitch,
+    const void* src, size_t spitch,
+    size_t width, size_t height,
+    cudaMemcpyKind kind
+) {
+    constexpr size_t MAX_ROWS = 1u << 20;
+    for (size_t off = 0; off < height; off += MAX_ROWS) {
+        size_t rows = std::min(MAX_ROWS, height - off);
+        cudaError_t err = cudaMemcpy2D(
+            static_cast<char*>(dst) + off * dpitch, dpitch,
+            static_cast<const char*>(src) + off * spitch, spitch,
+            width, rows, kind
+        );
+        if (err != cudaSuccess) return err;
+    }
+    return cudaSuccess;
+}
+
