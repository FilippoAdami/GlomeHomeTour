# Build output / caches — regenerated by gradlew, never hand-edited
**/build/
**/.gradle/
**/.cxx/
**/captures/
**/.idea/
**/local.properties
*.iml
**.cache
**.claude

# Gradle wrapper binary
**/gradle/wrapper/gradle-wrapper.jar

# Compiled/packaged artifacts
*.apk
*.aab
*.dex
*.jar
*.so
*.class
**/DerivedData/

# AR/3D binary assets
*.usdz
*.arobject
*.arreferenceobject
*.fbx
*.obj

# Model checkpoints / weights — large binaries, not source
*.onnx
*.pt
*.pth
*.tflite
*.mlmodel
*.mlpackage

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
*.egg-info/
**/.pytest_cache/


# Node
**/node_modules/
**/dist/
**/.next/

# graphify's own cache (source graph, not project source)
graphify-out/cache/

# Archived mobile variants — mobile_3.0 (renamed to mobile/) won; these are dead ends, not active source
mobile_0.0/
mobile_1.0/
mobile_2.0/

# Misc large/binary docs not needed for code context
*.pdf
*.ply
*.zip
*.pt
*.glb

# Reconstruction pipeline outputs/caches — regenerated, not source
backend/scenes/*.zip
backend/scenes/**/*.ply
backend/scenes/**/*.npy
backend/scenes/**/*.npz
backend/scenes/**/*.png
backend/scenes/**/*.jpg
backend/scenes/**/cache/
