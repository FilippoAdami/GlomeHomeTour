<resources>
    <!-- Edge-to-edge: the camera feed runs under the system bars and the HUD insets itself
         (CaptureActivity.applyInsets), so nothing important hides behind a notch or a gesture bar. -->
    <style name="Theme.GlomeArScan" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
