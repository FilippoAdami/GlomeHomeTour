<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- No storage permission: the dataset is written through MediaStore under Documents/,
         which needs none on API 29+ (minSdk here is 30). See DatasetWriter. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="Glome AR-Scan"
        android:theme="@style/Theme.GlomeArScan">
        <meta-data android:name="com.google.ar.core" android:value="required" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
