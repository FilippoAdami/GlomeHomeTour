{
  "$id": "https://glomehometour.dev/schemas/certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlomeHomeTour certificate.json",
  "description": "Cryptographic and pipeline provenance certificate generated by mobile ScanProcessor before ZIP compression.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "producer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "policy_version": { "type": "string" },
    "completed_stages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "orientation_state": {
      "type": "object",
      "properties": {
        "raw_width": { "type": "integer" },
        "raw_height": { "type": "integer" },
        "raw_orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "is_already_portrait": { "type": "boolean" },
        "processed_width": { "type": "integer" },
        "processed_height": { "type": "integer" },
        "processed_orientation": { "type": "string", "enum": ["portrait"] },
        "rotation_applied_deg": { "type": "integer", "enum": [0, 90] },
        "pose_rolled": { "type": "boolean" }
      },
      "required": [
        "raw_width", "raw_height", "raw_orientation", "is_already_portrait",
        "processed_width", "processed_height", "processed_orientation",
        "rotation_applied_deg", "pose_rolled"
      ],
      "additionalProperties": false
    },
    "keyframe_density_settings": {
      "type": "object",
      "properties": {
        "keyframe_filter_enabled": { "type": "boolean" },
        "keyframes_per_m2_lo": { "type": "number" },
        "keyframes_per_m2_hi": { "type": "number" },
        "base_keyframes": { "type": "number" },
        "standoff_m": { "type": "number" },
        "min_room_area_m2": { "type": "number" },
        "min_translation_m": { "type": "number" },
        "min_rotation_deg": { "type": "number" },
        "quality_gate_blur_threshold": { "type": "number" },
        "decimation_stride": { "type": "integer" }
      },
      "required": [
        "keyframe_filter_enabled", "keyframes_per_m2_lo", "keyframes_per_m2_hi",
        "base_keyframes", "standoff_m", "min_room_area_m2", "min_translation_m",
        "min_rotation_deg", "quality_gate_blur_threshold", "decimation_stride"
      ],
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "properties": {
        "total_input_frames": { "type": "integer", "minimum": 0 },
        "retained_frames_count": { "type": "integer", "minimum": 0 },
        "discarded_frames_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["total_input_frames", "retained_frames_count", "discarded_frames_count"],
      "additionalProperties": false
    },
    "manifest_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "image_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  },
  "required": [
    "schema_version",
    "producer",
    "policy_version",
    "completed_stages",
    "orientation_state",
    "keyframe_density_settings",
    "frames",
    "manifest_hashes",
    "image_hashes"
  ],
  "additionalProperties": false
}
