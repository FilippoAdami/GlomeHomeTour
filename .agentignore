**/*.pyc
**/.venv/
**/venv/
*.egg-info/

# Node
**/node_modules/
**/dist/
**/.next/

# graphify cache
graphify-out/cache/

# Archived mobile variants — dead ends, active source is mobile/
mobile_0.0/
mobile_1.0/
mobile_2.0/

# Misc large/binary docs
*.pdf

# Reconstruction pipeline outputs/caches — regenerated, not source
backend/scenes/*.zip
backend/scenes/**/*.ply
backend/scenes/**/*.npy
backend/scenes/**/*.npz
backend/scenes/**/*.png
backend/scenes/**/*.jpg
backend/scenes/**/cache/
backend/.pytest_cache/

