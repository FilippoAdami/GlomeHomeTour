*.iml

# Gradle wrapper binary
**/gradle/wrapper/gradle-wrapper.jar

# Compiled/packaged artifacts
*.apk
*.aab
*.dex
*.jar
*.so
*.class
**/DerivedData/

# AR/3D binary assets
*.usdz
*.arobject
*.arreferenceobject
