# Build output / caches — regenerated by gradlew, never hand-edited
**/build/
**/.gradle/
**/.cxx/
**/captures/
**/.idea/
**/local.properties
*.iml
**/gradle/wrapper/gradle-wrapper.jar

# Compiled/packaged artifacts
*.apk
*.aab
*.dex
*.class
*.so

# Vendored third-party repos
backend/third_party/

# graphify's own output (regenerated, not source)
graphify-out/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
*.egg-info/

# Node
**/node_modules/
**/dist/
**/.next/

# OS/editor cruft
.DS_Store
*.swp

# Model checkpoints / weights — large binaries, not source
*.onnx
*.pt
*.pth
*.tflite
*.mlmodel
*.mlpackage

# AR/3D binary assets
*.usdz
*.arobject
*.arreferenceobject
*.fbx
*.obj
*.glb
*.ply

# Large/compressed artifacts
*.zip
*.npy
*.npz

# Reconstruction artifacts — regenerated by backend/run_sliding_window_reconstruction.py
backend/scenes/
